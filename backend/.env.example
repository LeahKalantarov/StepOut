# Copy this file to ".env" and paste your real keys in.
# ".env" is gitignored, so your keys never get committed.

# Reads handwriting. Both values come from https://developer.myscript.com
MYSCRIPT_APPLICATION_KEY=paste-your-application-key-here
MYSCRIPT_HMAC_KEY=paste-your-hmac-key-here

# Explains a wrong step in words. From https://platform.openai.com/api-keys
# Optional: without it the app still checks the work, it just reports the
# mistake plainly instead of teaching through it.
OPENAI_API_KEY=paste-your-openai-key-here

# Reads a photograph of work done on paper. Needs to be a model that can see
# images; set it here if the default cannot. Without a key, photographs come
# back as "I couldn't read any maths in that photo" and everything else works.
PHOTO_MODEL=gpt-5.6-luna
